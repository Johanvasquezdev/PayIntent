# Demo mode works without credentials. Never use live PayPal credentials here.
PAYINTENT_MODE=mock
DATABASE_PATH=./data/payintent.db

# For a real draft in PayPal Sandbox, set PAYINTENT_MODE=sandbox and add sandbox keys.
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Exact email of the Sandbox Business account associated with the app.
# PAYPAL_SANDBOX_BUSINESS_EMAIL=

# Optional Jev classification. Without this key the UI clearly labels mock classification.
# TYPESAFE_API_KEY=
# Or use Gemini free-tier access from Google AI Studio.
# GEMINI_API_KEY=
